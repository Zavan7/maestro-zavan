# Copie para agente.env (fora do Git) e cole o token do agente, gerado em
# configurações → agentes. Fica separado do .env para o token não chegar
# ao worker, que repassa o próprio ambiente aos robôs.
MAESTRO_TOKEN=mae_...

# Opcional. Usuário do sistema com que os robôs rodam ("uid:gid" ou o nome).
# Exige que o agente rode como root.
# AGENTE_USUARIO_ROBOS=maestro-robos
