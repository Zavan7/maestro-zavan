# Copie para .env e troque os valores. O .env não vai para o Git.

# Gere uma chave com:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Com DEBUG=True (ou em manage.py test), uma chave fixa de desenvolvimento é usada se esta ficar vazia.
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CELERY_BROKER_URL=redis://localhost:6379/0

# Opcional. Pasta com os scripts aprovados; sem ela, usa scripts/ do projeto.
# ROBOS_SCRIPTS_DIR=/caminho/absoluto/para/scripts
