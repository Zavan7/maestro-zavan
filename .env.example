# Copie para .env e troque os valores. O .env não vai para o Git.

# Gere uma chave com:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Com DEBUG=True (ou em manage.py test), uma chave fixa de desenvolvimento é usada se esta ficar vazia.
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS: cookies só por HTTPS, redirecionamento de http para https e HSTS.
# Padrão: ligado em produção (DEBUG=False) e desligado em desenvolvimento.
# USAR_HTTPS=True
# Segundos do HSTS; comece baixo e suba (ex.: 31536000) quando estiver estável.
# HSTS_SEGUNDOS=3600
# Atrás de um proxy (nginx, Caddy) que termina o TLS e manda X-Forwarded-Proto.
# ATRAS_DE_PROXY_HTTPS=True
# Origens aceitas no CSRF, com esquema: https://maestro.exemplo.com
# CSRF_TRUSTED_ORIGINS=https://maestro.exemplo.com

CELERY_BROKER_URL=redis://localhost:6379/0
# Opcional. Redis do Django Channels (log ao vivo); padrão: banco 1.
# CHANNELS_REDIS_URL=redis://localhost:6379/1

# Opcional. Pasta com os scripts aprovados; sem ela, usa scripts/ do projeto.
# ROBOS_SCRIPTS_DIR=/caminho/absoluto/para/scripts

# Opcional. Onde o worker guarda o ambiente de cada robô (uv, poetry, pip...),
# em vez do .venv dentro da pasta dele.
# ROBOS_PASTA_VENVS=/caminho/absoluto/para/venvs

# Os robôs NÃO recebem este .env: só variáveis básicas do sistema (PATH, HOME,
# LANG, proxy, certificados...) e as que começam com ROBO_. Para passar uma
# credencial a um robô, use o prefixo: ROBO_SENHA_SAP=...

# Opcional e recomendado em produção. Usuário do sistema com que o worker roda
# os robôs ("uid:gid" ou o nome), para que eles não leiam o .env nem o banco.
# Exige que o worker rode como root.
# ROBOS_USUARIO=maestro-robos

# Docker: pasta dos robôs no host, montada em /robos no container do agente.
# AGENTE_ROBOS_HOST=/caminho/absoluto/dos/robos
